PORT=3000
DESTINATION_HOURLY_FEE=7500
NODE_ENV=development
# 운영에서 허용할 Origin을 쉼표로 입력
# 예: ALLOWED_ORIGINS=https://kkulparking.com,https://www.kkulparking.com
ALLOWED_ORIGINS=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=180
REPORT_RATE_LIMIT_MAX=20
# 카카오 JavaScript 키 (직접 입력)
KAKAO_JAVASCRIPT_KEY=
# 카카오 REST API 키 (서버 프록시/백엔드 호출용)
KAKAO_REST_API_KEY=

# 공유누리 API 설정
GONGYU_NURI_API_KEY=
GONGYU_NURI_BASE_URL=https://www.eshare.go.kr

# 공공데이터포털 API 키 설정 (총 5개)
DATA_GO_KR_AIRPORT_PARKING_CONGESTION_API_KEY=
DATA_GO_KR_POCHEON_PARKING_INFO_API_KEY=
DATA_GO_KR_CHUNGJU_MARKET_PARKING_API_KEY=
DATA_GO_KR_GWANGYANG_PARKING_INFO_API_KEY=
DATA_GO_KR_DAEJEON_REALTIME_PARKING_API_KEY=

# 공공데이터포털 API End Point 설정 (선택)
DATA_GO_KR_AIRPORT_PARKING_CONGESTION_ENDPOINT=
DATA_GO_KR_POCHEON_PARKING_INFO_ENDPOINT=
DATA_GO_KR_CHUNGJU_MARKET_PARKING_ENDPOINT=
DATA_GO_KR_GWANGYANG_PARKING_INFO_ENDPOINT=
DATA_GO_KR_DAEJEON_REALTIME_PARKING_ENDPOINT=
